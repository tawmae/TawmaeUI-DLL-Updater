<Window x:Class="TawmaeUIUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TawmaeUI DLL Updater"
        Icon="Assets/tawmae.ico"
        Width="460"
        Height="450"
        MinWidth="380"
        MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#151515"
        Foreground="#F5F5F5"
        FontFamily="./Assets/Fonts/#Host Grotesk, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#151515" />
        <SolidColorBrush x:Key="Surface" Color="#1C1C1C" />
        <SolidColorBrush x:Key="Raised" Color="#272727" />
        <SolidColorBrush x:Key="Hover" Color="#303030" />
        <SolidColorBrush x:Key="Line" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#F5F5F5" />
        <SolidColorBrush x:Key="Muted" Color="#A6A6A6" />
        <SolidColorBrush x:Key="Faint" Color="#7C7C7C" />
        <SolidColorBrush x:Key="Accent" Color="#86D3B7" />
        <SolidColorBrush x:Key="AccentInk" Color="#0E1F19" />
        <SolidColorBrush x:Key="Warning" Color="#FFC766" />
        <SolidColorBrush x:Key="WarningSoft" Color="#1FFFC766" />

        <!-- ============================================================ -->
        <Style x:Key="Focus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="#86D3B7" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Padding="10,6" CornerRadius="6" BorderThickness="1" BorderBrush="#21FFFFFF" Background="#0C0C0C" MaxWidth="280">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#F5F5F5" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Grip" Margin="4" CornerRadius="2" Background="#29FFFFFF" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Grip" Property="Background" Value="#47FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFF8A80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Padding="6,4" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Big" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" />
                            <Border x:Name="Shine" CornerRadius="8" Background="White" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Shine" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tool" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ============================================================ -->
    <Border x:Name="Root" Background="{StaticResource Bg}" BorderBrush="#2E2E2E" BorderThickness="0" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <Grid x:Name="TitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Margin="10,0,10,0" VerticalAlignment="Center" Source="Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="13.5" FontWeight="Medium" Text="TawmaeUI DLL Updater" />
                <Button x:Name="MinButton" Grid.Column="2" Style="{StaticResource Caption}" Content="&#xE921;" AutomationProperties.Name="Minimize" Click="OnMinimize" />
                <Button x:Name="MaxButton" Grid.Column="3" Style="{StaticResource Caption}" Content="&#xE922;" AutomationProperties.Name="Maximize" Click="OnMaximize" />
                <Button x:Name="CloseButton" Grid.Column="4" Margin="0,0,10,0" Style="{StaticResource CaptionClose}" Content="&#xE8BB;" AutomationProperties.Name="Close" Click="OnClose" />
            </Grid>

            <!-- ============================================================ -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Padding="12,2,12,10" MinHeight="{Binding ViewportHeight, ElementName=Scroller}">
                    <Grid MaxWidth="640">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="Notice" Margin="0,0,0,8" Padding="12,10" CornerRadius="10" Background="{StaticResource WarningSoft}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl x:Name="NoticeIcon" Margin="0,2,9,0" VerticalAlignment="Top" Foreground="{StaticResource Warning}" Focusable="False" />
                                <TextBlock x:Name="NoticeText" Grid.Column="1" FontSize="13" LineHeight="19.5" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" CornerRadius="10" Background="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="16,18,16,16" VerticalAlignment="Center">
                                    <Border x:Name="Chip" HorizontalAlignment="Center" Height="20" Padding="9,0" CornerRadius="3" Background="#343434" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <SkewTransform AngleX="-12" />
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="ChipText" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <SkewTransform AngleX="12" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock x:Name="Value" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="50" FontWeight="Bold"
                                               LineHeight="56" LineStackingStrategy="BlockLineHeight" />

                                    <TextBlock x:Name="Facts" Margin="0,6,0,0" MinHeight="18" HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Muted}" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Primary" Style="{StaticResource Big}" IsDefault="True" Click="OnPrimary" />
                                        <Button x:Name="Side" Grid.Column="1" Margin="6,0,0,0" MinWidth="62" Style="{StaticResource Big}" Visibility="Collapsed" Click="OnSide" />
                                        <Button x:Name="RefreshButton" Grid.Column="2" Margin="6,0,0,0" Width="40" Padding="0" Style="{StaticResource Big}"
                                                ToolTip="Check again" AutomationProperties.Name="Check again" Click="OnRefresh" />
                                    </Grid>
                                </StackPanel>

                                <Border x:Name="Tools" Grid.Row="1" Margin="12,0,12,10" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="FolderButton" Style="{StaticResource Tool}" ToolTip="Show in Explorer" AutomationProperties.Name="Show in Explorer" Click="OnFolder" />
                                        <TextBlock x:Name="FolderText" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SourceButton" Style="{StaticResource Link}" ToolTip="Open the source code on GitHub" AutomationProperties.Name="Source code" Click="OnSource">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl x:Name="SourceIcon" Focusable="False" VerticalAlignment="Center" />
                                    <TextBlock Text="Source code" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BrandButton" Grid.Column="2" Style="{StaticResource Link}" ToolTip="Open tawmae.xyz" AutomationProperties.Name="Open tawmae.xyz" Click="OnBrand">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="3">
                                        <Border.Background>
                                            <ImageBrush ImageSource="Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="tawmae.xyz" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
